<table class="table">
  <thead>
    <tr>
      <th>Field</th>
      <th>Value</th>
    </tr>
  </thead>
  <tbody>
    <% pairs.each do |key, value| %>
      <tr>
        <th><%= key %></th>
        <td><pre><%= JSON.pretty_generate(value) %></pre>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
