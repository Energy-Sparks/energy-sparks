<% if installation.information.present? %>
  <h2>Site configuration</h2>
  <p>
    Some of the following information (e.g. the site and meter status) is based on a cached summary of the site description.
  </p>
  <p>
    Cached data is updated daily when loading is enabled.
    <%= link_to 'Edit and then save the site', edit_school_solar_edge_installation_path(school, installation) %>
    to update the cached data now.
  </p>

  <table class="table">
    <thead>
      <tr>
        <th>Configuration</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>User granted consent?</td>
        <td><%= installation.consented? %></td>
      </tr>
      <tr>
        <td>Consent granted</td>
        <td><%= nice_date_times(installation.consent_granted_at) if installation.consented? %></td>
      </tr>
      <tr>
        <td>SolarEdge monitoring active?</td>
        <td><%= installation.monitoring_active? %></td>
      </tr>
      <tr>
        <td>Production date begins</td>
        <td><%= installation.information&.dig('dates', 'from') if installation.consented? %></td>
      </tr>
      <tr>
        <td>SolarEdge grid import meter active?</td>
        <td><%= installation.cached_meter_metadata(:electricity)&.dig('active') %></td>
      </tr>
      <tr>
        <td>SolarEdge export meter active?</td>
        <td><%= installation.cached_meter_metadata(:exported_solar_pv)&.dig('active') %></td>
      </tr>
    </tbody>
  </table>

  <h2>Debugging</h2>
  <table class="table">
    <tbody>
      <tr>
        <td>Access token</td>
        <td><%= installation.access_token %></td>
      </tr>
      <tr>
        <td>Refresh token</td>
        <td><%= installation.refresh_token %></td>
      </tr>
      <tr>
        <td>Access token expires</td>
        <td><%= nice_date_times(installation.access_token_expires_at) if installation.access_token_expires_at %></td>
      </tr>
    </tbody>
  </table>

  <h3>Cached data</h3>
  <%= render 'key_value_table', pairs: installation.information %>
<% else %>
  <p>There is no cached copy of the site metadata</p>
<% end %>
