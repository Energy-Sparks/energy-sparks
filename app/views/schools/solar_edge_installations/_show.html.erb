<% if installation.cached_api_information? %>
  <h2>Cached site information</h2>
  <p>
    The following is a cached summary of the site description. It was last refreshed on
    <%= nice_date_times(installation.updated_at) %>.
  </p>
  <p>
    <%= link_to 'Edit and then save the site', edit_school_solar_edge_installation_path(school, installation) %>
    to update this cached copy. Or click the links below to view live (raw) data.
  </p>
  <%= render 'key_value_table', pairs: installation.information %>
<% else %>
  <p>There is no cached copy of the site metadata</p>
<% end %>

<h2>Solar Edge v2 Debugging</h2>
<table class="table">
  <tbody>
    <tr>
      <td>Consent Granted At</td>
      <td><%= nice_date_times(installation.consent_granted_at) if installation.consent_granted_at %></td>
    </tr>
    <tr>
      <td>Access token</td>
      <td><%= installation.access_token %></td>
    </tr>
    <tr>
      <td>Refresh token</td>
      <td><%= installation.refresh_token %></td>
    </tr>
    <tr>
      <td>Access token expires</td>
      <td><%= nice_date_times(installation.access_token_expires_at) if installation.access_token_expires_at %></td>
    </tr>
  </tbody>
</table>
