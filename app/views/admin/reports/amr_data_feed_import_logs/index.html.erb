<% if @dashboard_user %>
  <% content_for :title do %>
    <%= "#{@dashboard_user.display_name}'s Data Feed Import Logs" %>
  <% end %>

  <%= render Elements::ButtonComponent.new('View all imports',
                                           admin_reports_lagging_meters_path,
                                           style: :secondary,
                                           classes: 'mb-2 me-2') %>

<% else %>
  <%= render 'admin/reports/title', title: 'Data Feed Import Logs' %>
  <%= render 'tabs' %>
<% end %>

<p>Summary of all data loads completed over the last
  <%= Admin::Reports::AmrDataFeedImportLogsController::SUMMARY_PERIOD_IN_DAYS %> days.
</p>

<table class="table table-bordered table-sorted" id="import-summary-table">
  <thead>
    <tr>
      <th colspan="1"></th>
      <th class="text-end">Successes</th>
      <th class="text-center" colspan="3">Rejections</th>
      <th class="text-center" colspan="3">Errors</th>
      <th></th>
    </tr>
    <tr>
      <th>Feed</th>
      <th class="text-end">Total</th>
      <th class="text-end">Last 24 hours</th>
      <th class="text-end">Previous 24 hours</th>
      <th class="text-end">Total</th>
      <th class="text-end">Last 24 hours</th>
      <th class="text-end">Previous 24 hours</th>
      <th class="text-end">Total</th>
      <th class="text-end">Total</th>
    </tr>
  </thead>
  <tbody>
  <% @amr_data_feed_configs.each do |config| %>
    <tr class="<%= 'table-warning' unless config.enabled %>">
    <% import_logs = config.amr_data_feed_import_logs
                           .since(Admin::Reports::AmrDataFeedImportLogsController::SUMMARY_PERIOD_IN_DAYS.days.ago) %>
    <td class='text-start'>
      <%= link_to config.description, admin_amr_data_feed_config_path(config) %>
    </td>
    <td class="text-end">
      <%= link_to import_logs.successful.count,
                  admin_reports_amr_data_feed_import_logs_successes_path({ config: { config_id: config.id } }) %>
    </td>

    <td class="text-end">
      <%= import_logs.with_warnings.where(import_time: 24.hours.ago..Time.zone.now).count %>
    </td>
    <td class="text-end">
      <%= import_logs.with_warnings.where(import_time: 48.hours.ago..24.hours.ago).count %>
    </td>
    <td class="text-end">
      <%= link_to import_logs.with_warnings.count,
                  admin_reports_amr_data_feed_import_logs_warnings_path({ config: { config_id: config.id } }) %>
    </td>

    <td class="text-end">
      <%= import_logs.where.not(error_messages: nil).where(import_time: 24.hours.ago..Time.zone.now).count %>
    </td>
    <td class="text-end">
      <%= import_logs.where.not(error_messages: nil).where(import_time: 48.hours.ago..24.hours.ago).count %>
    </td>
    <td class="text-end">
      <%= link_to import_logs.where.not(error_messages: nil).count,
                  admin_reports_amr_data_feed_import_logs_errors_path({ config: { config_id: config.id } }) %>
    </td>
    <td class="text-end">
      <%= import_logs.count %>
    </td>
    </tr>
  <% end %>
  </tbody>
  <tfooter>
    <tr>
      <td>All Feeds</td>
      <td class="text-end"><%= @successes_count %></td>
      <td></td>
      <td></td>
      <td class="text-end"><%= @warnings_count %></td>
      <td></td>
      <td></td>
      <td class="text-end"><%= @errors_count %></td>
      <td class="text-end"><%= @successes_count + @errors_count %></td>
    </tr>
  </tfooter>
</table>
