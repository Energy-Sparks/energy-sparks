<% content_for :header_title, "Bulk meter updates: #{@school_group.name}" %>

<div class="container">
  <div class="row">
    <%= render 'section', field: :data_source, collection: DataSource.all, label_method: 'name', 
                          default_field: 'default_data_source', school_group: @school_group %>
    <%= render 'section', field: :procurement_route, collection: ProcurementRoute.all,
                          label_method: 'organisation_name', default_field: 'default_procurement_route',
                          school_group: @school_group %>
  </div>
  <div class="row">
    <%= render 'section', field: :supplier, collection: Supplier.by_name, label_method: 'name', default_field: nil,
                          school_group: @school_group %>
    <%= render 'section', field: :admin_meter_status, collection: AdminMeterStatus.by_label, label_method: 'label',
                          attribute: :admin_meter_statuses_id, default_field: 'admin_meter_statuses',
                          school_group: @school_group %>
  </div>
</div>
