<% content_for :head do %>
  <%= javascript_import_module_tag 'tom_select' %>
<% end %>

<%= render 'shared/errors', subject: @activity_type, subject_name: 'activity' %>

<%= simple_form_for([:admin, activity_type], html: { id: 'activity_type_form' }) do |f| %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :name do |locale| %>
    <%= f.input t_field(:name, locale), label: ActivityType.human_attribute_name(:name), as: :string %>
  <% end %>

  <%= f.input :activity_category_id,
              as: :select,
              label: 'Category',
              collection: ActivityCategory.all,
              include_blank: false %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :image do |locale| %>
    <%= f.label 'Image' %>
    <p class="small">
      This image will appear in the right-hand panel next to both non-specific and school-specific descriptions.
    </p>
    <div class="upload-preview">
      <div class="col-md-3">
        <% t_image = "image_#{locale}".to_sym %>
        <% if !f.object.send(t_image).blank? %>
          <%= image_tag f.object.send(t_image), width: '300px' %>
        <% else %>
          <%= image_tag '1x1.png' %>
        <% end %>
      </div>
    </div>
    <%= f.input t_field(:image, locale), label: false %>
  <% end %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :summary do |locale| %>
    <%= f.input t_field(:summary, locale), label: ActivityType.human_attribute_name(:summary), as: :string %>
    <p class="small">The summary text will appear on lists of activities.</p>
  <% end %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :download_links do |locale| %>
    <div class="download-links-trix-editor <%= locale %>">
      <%= f.label ActivityType.human_attribute_name(:download_links) %>
      <p class="small">These download links will appear in the right-hand panel under the image.</p>
      <%= f.rich_text_area t_field(:download_links, locale) %>
    </div>
  <% end %>

  <%= render 'link_rewrites', f: f %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :description do |locale| %>
    <div class="description-trix-editor <%= locale %>">
      <%= f.label ActivityType.human_attribute_name(:description) %>
      <p class="small">
        Note: This is the non-school specific description for non-logged in users. The site will default to this
        one if the school specific one has not been set.
      </p>
      <%= f.rich_text_area t_field(:description, locale) %>
    </div>
  <% end %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :school_specific_description do |locale| %>
    <div class="school-specific-description-trix-editor <%= locale %>">
      <%= f.label ActivityType.human_attribute_name(:school_specific_description) %>
      <%= render 'admin/shared/preview_section',
                 scope: 'school-specific-description',
                 preview_url: admin_activity_type_preview_path,
                 no_timings: true,
                 no_weightings: true,
                 locales: [locale] do |locale| %>
                  <%= render(Forms::TrixComponent.new(form: f, field: t_field(:school_specific_description, locale),
                                                      charts: @chart_list)) %>
      <% end %>
    </div>
  <% end %>

  <div class='rounded bg-light p-3 mb-3'>
  <h2 class="py-0">Properties</h2>
    <div class="row">
      <div class="col-md-6">
        <%= f.input :score, label: 'Score', as: :string,
                            hint: 'The score that will be awarded to a school for logging this activity' %>
      </div>
      <div class="col-md-6">
        <%= f.input :maximum_frequency,
                    as: :string,
                    hint: 'The maximum times a school can record this activity this academic year ' \
                                                'and still be awarded a score. After this they get zero.' %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <%= f.input :active %>
      </div>
      <div class="col-md-6">
        <%= f.input :data_driven, label: 'Uses data?' %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <%= f.input :custom, label: "Custom ('Other')" %>
      </div>
      <div class="col-md-6">
        <%= f.input :show_on_charts, label: 'Show on charts?' %>
      </div>
    </div>

    <%= f.input :fuel_type, as: :select, label: 'Fuel types',
                            collection: ActivityType::VALID_FUEL_TYPES.map { |fuel_type|
                              [fuel_type.to_s.humanize, fuel_type.to_s]
                            },
                            input_html: { multiple: true, class: 'tom-select' } %>
  </div>
  <% if Flipper.enabled?(:activity_classifications) %>
    <div class='rounded bg-light p-3 mb-3'>
      <h2 class="py-0">Classifications</h2>

      <%= f.input :aim_ids, as: :select, label: 'Aims',
                            collection: Task::Label.aim.by_name,
                            input_html: { multiple: true, class: 'tom-select' } %>

      <%= f.input :topic_ids, as: :select, label: 'Topics',
                              collection: Task::Label.topic.by_name,
                              input_html: { multiple: true, class: 'tom-select' } %>

      <%= f.input :duration_ids, as: :select, label: 'Durations',
                                 collection: Task::Label.duration.by_name,
                                 input_html: { multiple: true, class: 'tom-select' } %>

      <h5>Subject areas</h5>
      <div class="row">
        <%= f.hidden_field :subject_area_ids, multiple: true, value: '' %>
        <% Enums::Country::ENUM_COUNTRY.each_key do |country| %>
          <div class="col-md-4 mb-3">
            <%= f.input :subject_area_ids,
                        as: :select,
                        label: country.to_s.humanize,
                        collection: ::Activities::SubjectArea.for_country(country).by_name,
                        include_hidden: false,
                        input_html: {
                          multiple: true,
                          id: "#{f.object_name}_subject_area_ids_#{country}",
                          class: 'tom-select'
                        } %>
          </div>
        <% end %>
      </div>

      <h5>Learning stages</h5>
      <div class="row">
        <%= f.hidden_field :learning_stage_ids, multiple: true, value: '' %>
        <% Enums::Country::ENUM_COUNTRY.each_key do |country| %>
          <div class="col-md-4 mb-3">
            <%= f.input :learning_stage_ids,
                        as: :select,
                        label: country.to_s.humanize,
                        collection: LearningStage.for_country(country).by_name,
                        include_hidden: false,
                        input_html: {
                          multiple: true,
                          id: "#{f.object_name}_learning_stage_ids_#{country}",
                          class: 'tom-select'
                        } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render(TogglerDropdownComponent.new(
               hide: Flipper.enabled?(:activity_classifications),
               title: 'Deprecated Classifications', classes: 'mt-3 mb-3'
             )) do %>

    <h2>Key Stages</h2>
    <%= render 'crud_filter_checkboxes', field: :key_stage_ids, collection: @key_stages, form: f %>

    <h2>Impacts</h2>
    <%= render 'crud_filter_checkboxes', field: :impact_ids, collection: @impacts, form: f %>

    <h2>Subjects</h2>
    <%= render 'crud_filter_checkboxes', field: :subject_ids, collection: @subjects, form: f %>

    <h2>Timings</h2>
    <%= render 'crud_filter_checkboxes', field: :activity_timing_ids, collection: @activity_timings, form: f %>

  <% end %>

  <h2>Suggested Next Activities</h2>

  <div class="row">
    <div class="col-md-8 mb-3">
      <label for="firstName">Activity</label>
    </div>
    <div class="col-md-1 mb-3">
      <label for="lastName">Delete?</label>
    </div>
  </div>

  <% grouped_activity_types = ActivityType.grouped_by_category %>

  <%= f.fields_for :activity_type_suggestions do |suggestion| %>
    <div class="row">
      <div class="col-md-8 mb-3">
        <%= suggestion.select(
              :suggested_type_id,
              grouped_options_for_select(
                grouped_activity_types.map do |category, types|
                  [category.name, types.map { |type| [type.name, type.id] }]
                end,
                suggestion.object.suggested_type_id
              ),
              { include_blank: true },
              { class: 'form-select tom-select' }
            ) %>
      </div>
      <div class="col-md-1 mb-3">
        <div class="form-check">
          <%= suggestion.check_box :_destroy, class: 'form-check-input' %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit 'Save', class: 'btn btn-primary' %>
    <%= link_to 'Back', admin_activity_types_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
