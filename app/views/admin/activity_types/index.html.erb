<%= render Admin::HeaderNavComponent.new do |header_nav| %>
  <% header_nav.with_header title: 'Manage activities' %>
  <% header_nav.with_dropdown title: 'Jump to category',
                              id: 'categoryDropdown',
                              items: ActivityCategory.by_name.map { |category|
                                [category.name, "#activity-category-#{category.id}"]
                              },
                              classes: 'me-2' %>
  <% header_nav.with_button 'New Activity', new_admin_activity_type_path,
                            style: :primary, size: nil %>
<% end %>

<p class="mb-4">
  Activities highlighted in <span class="bg-warning">yellow</span>
  are inactive and no longer visible to users.
</p>

<% ActivityCategory.by_name.each do |activity_category| %>
  <h2 id="activity-category-<%= activity_category.id %>" class='scrollable-title'>
    <%= activity_category.name %>
  </h2>
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th scope="col">Id</th>
        <th scope="col">Name</th>
        <th scope="col">School specific instructions?</th>
        <th scope="col">Score</th>
        <th scope="col">Key Stages</th>
        <th scope="col"></th>
      </tr>
    </thead>

    <tbody>
      <% activity_category.activity_types.by_id.each do |activity_type| %>
        <tr class="<%= active(activity_type.active) %>" scope="row">
          <td><%= activity_type.id %></td>
          <td><%= link_to activity_type.name, admin_activity_type_path(activity_type) %></td>
          <% icon = if activity_type.school_specific_description.present?
                      'check-circle text-success'
                    else
                      'times-circle text-muted'
                    end %>
          <td><%= fa_icon(icon) %></td>
          <td><%= activity_type.score %></td>
          <td><%= activity_type.key_stage_list %></td>
          <td class="text-nowrap text-end">
            <%= link_to 'Edit', edit_admin_activity_type_path(activity_type),
                        class: 'btn btn-secondary btn-sm' %>
            <%= link_to 'Report', admin_reports_activity_type_path(activity_type),
                        class: 'btn btn-secondary btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= link_to 'New Activity', new_admin_activity_type_path, class: 'btn btn-primary' %>
