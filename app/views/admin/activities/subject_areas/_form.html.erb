<% content_for :title, "Activities and actions: #{@subject_area.new_record? ? 'new' : 'edit'} subject area" %>

<% countries = Enums::Country::ENUM_COUNTRY.map { |country, value| [country.to_s.titleize, value] } %>

<%= render Admin::Tasks::ClassificationTabsComponent.new(current: @tab, country: @subject_area.country) %>

<% unless @subject_area.new_record? %>
  <%= render 'admin/activities/shared/country_tabs', resource: @subject_area %>
<% end %>

<% form_url = if @subject_area.new_record?
                admin_activities_subject_areas_path
              else
                admin_activities_subject_area_path(@subject_area)
              end %>

<div class="p-2">
  <%= simple_form_for([:admin, @subject_area], url: form_url) do |f| %>
    <%= f.input :country, collection: countries, include_blank: false if @subject_area.new_record? %>

    <%= render 'admin/shared/locale_tabs', f: f, field: :name do |locale| %>
      <%= f.input t_field(:name, locale), label: 'Name', as: :string %>
    <% end %>

    <div class="py-3 d-flex gap-2 align-items-center">
      <%= f.submit 'Save', class: 'btn btn-primary' %>

      <% unless @subject_area.new_record? %>
        <%= render Forms::DeleteButtonComponent.new(admin_activities_subject_area_path(@subject_area),
                                                    resource: @subject_area, size: nil) %>
      <% end %>
    </div>
  <% end %>
</div>
