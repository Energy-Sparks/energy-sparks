<ul class="nav nav-tabs mt-3 justify-content-end" id="country-tabs">
  <% resource_route = resource_class.model_name.element.pluralize.to_sym %>
  <% Enums::Country::ENUM_COUNTRY.values.each do |country_option| %>
    <li class="nav-item">
      <%= link_to country_option.to_s.titleize,
                  polymorphic_path([:admin, :activities, resource_route], country: country_option),
                  class: "nav-link #{'active' if country.to_s == country_option.to_s}" %>
    </li>
  <% end %>
</ul>
