<ul class="nav nav-tabs mt-3 justify-content-end" id="country-tabs">
  <% Enums::Country::ENUM_COUNTRY.values.each do |country_option| %>
    <li class=" nav-item ">
      <%= link_to country_option.to_s.titleize, country_path.call(country_option),
                  class: "nav-link #{'active' if country.to_s == country_option.to_s}" %>
    </li>
  <% end %>
</ul>
