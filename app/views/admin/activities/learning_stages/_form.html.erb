<% content_for :title, "Activities and actions: #{@learning_stage.new_record? ? 'new' : 'edit'} learning stage" %>

<% countries = Enums::Country::ENUM_COUNTRY.map { |country, value| [country.to_s.titleize, value] } %>

<%= render Admin::Tasks::ClassificationTabsComponent.new(current: @tab, country: @learning_stage.country) %>

<% unless @learning_stage.new_record? %>
  <% country_path = ->(country) { admin_activities_learning_stages_path(country: country) } %>
  <%= render 'admin/activities/shared/country_tabs', country: @learning_stage.country.to_sym, country_path: country_path %>
<% end %>

<% form_url = if @learning_stage.new_record?
                admin_activities_learning_stages_path
              else
                admin_activities_learning_stage_path(@learning_stage)
              end %>

<div class="p-2">
  <%= simple_form_for([:admin, @learning_stage], url: form_url) do |f| %>
    <%= f.input :country, collection: countries, include_blank: false if @learning_stage.new_record? %>

    <%= render 'admin/shared/locale_tabs', f: f, field: :name do |locale| %>
      <%= f.input t_field(:name, locale), label: LearningStage.human_attribute_name(:name), as: :string %>
    <% end %>

    <%= render 'admin/shared/locale_tabs', f: f, field: :abbreviation do |locale| %>
      <%= f.input t_field(:abbreviation, locale), label: LearningStage.human_attribute_name(:abbreviation), as: :string %>
    <% end %>

    <div class="py-3 d-flex gap-2 align-items-center">
      <%= f.submit 'Save', class: 'btn btn-primary' %>

      <% unless @learning_stage.new_record? %>
        <%= render Forms::DeleteButtonComponent.new(admin_activities_learning_stage_path(@learning_stage),
                                                    resource: @learning_stage, size: nil) %>
      <% end %>
    </div>
  <% end %>
</div>
