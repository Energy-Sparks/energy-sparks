<% content_for :title, 'Activities and actions: learning stages' %>

<%= render Admin::Tasks::ClassificationTabsComponent.new(current: @tab, country: @country) %>

<%= render 'admin/activities/shared/country_tabs', country: @country, resource_class: LearningStage %>

<% if @learning_stages.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Abbreviation</th>
        <th>Used by</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @learning_stages.each do |learning_stage| %>
        <tr>
          <td>
            <%= learning_stage.name %>
            <%= render Admin::TranslationFlagComponent.new(record: learning_stage, field: :name, locale: :cy) %>
          </td>
          <td>
            <%= learning_stage.abbreviation %>
            <%= render Admin::TranslationFlagComponent.new(record: learning_stage, field: :abbreviation,
                                                           locale: :cy) %>
          </td>
          <td><%= pluralize(learning_stage.activity_types.count, 'activity') %></td>
          <td class="fit nowrap text-end">
            <%= link_to 'Edit', edit_admin_activities_learning_stage_path(learning_stage),
                        class: 'btn btn-secondary btn-sm edit' %>
            <%= render(Forms::DeleteButtonComponent.new(admin_activities_learning_stage_path(learning_stage),
                                                        resource: learning_stage)) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No learning stages to display.</p>
<% end %>
