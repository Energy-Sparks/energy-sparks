<% content_for :head do %>
  <%= javascript_import_module_tag 'tom_select' %>
<% end %>

<%= render 'shared/errors', subject: @intervention_type, subject_name: 'action' %>

<%= simple_form_for([:admin, intervention_type], html: { id: 'intervention_type_form' }) do |f| %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :name do |locale| %>
    <%= f.input t_field(:name, locale), label: InterventionType.human_attribute_name(:name), as: :string %>
  <% end %>

  <%= f.input :intervention_type_group_id,
              as: :select,
              label: 'Category',
              collection: InterventionTypeGroup.all,
              include_blank: false %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :image do |locale| %>
    <%= f.label 'Image' %>

    <p class="small">This image will appear in the right-hand panel next to both non-specific and school-specific descriptions.</p>
    <div class="upload-preview">
      <div class="col-md-3">
        <% t_image = :"image_#{locale}" %>
        <% if !f.object.send(t_image).blank? %>
          <%= image_tag f.object.send(t_image), width: '300px' %>
        <% else %>
          <%= image_tag '1x1.png' %>
        <% end %>
      </div>
    </div>

    <%= f.input t_field(:image, locale), label: false %>
  <% end %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :summary do |locale| %>
    <%= f.input t_field(:summary, locale), label: InterventionType.human_attribute_name(:summary), as: :string %>
    <p class="small">The summary text will appear on lists of actions.</p>
  <% end %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :download_links do |locale| %>
    <div class="download-links-trix-editor <%= locale %>">
      <%= f.label InterventionType.human_attribute_name(:download_links) %>
      <p class="small">These download links will appear in the right-hand panel under the image.</p>
      <%= f.rich_text_area t_field(:download_links, locale) %>
    </div>
  <% end %>

  <%= render 'admin/activity_types/link_rewrites', f: f %>

  <%= render 'admin/shared/locale_tabs', f: f, field: :description do |locale| %>
    <div class="description-trix-editor <%= locale %>">
      <%= f.label InterventionType.human_attribute_name(:description) %>
      <p class="small">The description of the action for all users</p>
      <%= f.rich_text_area t_field(:description, locale) %>
    </div>
  <% end %>

  <div class='rounded bg-light p-3 mb-3'>
    <h2 class="py-0">Properties</h2>
    <div class="row">
      <div class="col-md-6">
        <%= f.input :score, label: 'Score', as: :string,
                            hint: 'The score that will be awarded to a school for logging this action' %>
      </div>
      <div class="col-md-6">
        <%= f.input :maximum_frequency, as: :string,
                                        hint: 'The maximum times a school can record this action this academic year ' \
                                          'and still be awarded a score. After this they get zero.' %>
      </div>
    </div>

    <%= f.input :active %>
    <%= f.input :custom, label: "Custom ('Other')" %>
    <%= f.input :show_on_charts, label: 'Show on charts?' %>

    <%= f.input :fuel_type, as: :select, label: 'Fuel types',
                            collection: InterventionType::VALID_FUEL_TYPES.map { |fuel_type|
                              [fuel_type.to_s.humanize, fuel_type.to_s]
                            },
                            input_html: { multiple: true, class: 'tom-select' } %>
  </div>

  <% if Flipper.enabled?(:activity_classifications) %>
    <div class='rounded bg-light p-3 mb-3'>
      <h2 class="py-0">Classifications</h2>

      <%= f.input :focus_ids, as: :select, label: 'Focuses',
                              collection: Task::Label.focus.by_name,
                              input_html: { multiple: true, class: 'tom-select' } %>
    </div>
  <% end %>

  <div class="intervention_type_suggestions">
    <h2>Suggested Next Actions</h2>

    <div class="row">
      <div class="col-md-8 mb-3">
        <label for="firstName">Action</label>
      </div>
      <div class="col-md-1 mb-3">
        <label for="lastName">Delete?</label>
      </div>
    </div>

    <%= f.fields_for :intervention_type_suggestions do |suggestion| %>
      <div class="row">
        <div class="col-md-8 mb-3">
          <%= suggestion.select(
                :suggested_type_id,
                grouped_options_for_select(
                  InterventionTypeGroup.listed_with_intervention_types.map do |group, types|
                    [group.name, types.map { |type| [type.name, type.id] }]
                  end,
                  suggestion.object.suggested_type_id.to_s
                ),
                { include_blank: true },
                { class: 'form-select tom-select' }
              ) %>
        </div>
        <div class="col-md-1 mb-3">
          <div class="form-check">
            <%= suggestion.check_box :_destroy, class: 'form-check-input' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="actions">
    <%= f.submit 'Save', class: 'btn btn-primary' %>
    <%= link_to 'Back', admin_intervention_types_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
