<% content_for :page_title, header.title %>

<div class="row">
  <div class="col d-flex flex-wrap align-items-center justify-content-between">
    <%= header %>
    <% if actions.any? %>
      <div>
        <% actions.each do |action| %>
          <%= action %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
