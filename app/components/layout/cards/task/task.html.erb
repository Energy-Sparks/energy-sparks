<%= link_to helpers.url_for(task), id: id, class: class_names(classes, 'd-block text-decoration-none') do %>
  <%= render Layout::CardComponent.new do |card| %>
    <%= card.with_image(
          src: cdn_link_url(task.t_attached_or_default(:image, placeholder: 'placeholder300x200.png')),
          rounded: :top,
          classes: 'border-top border-start border-end'
        ) %>
    <%= card.with_feature_card(theme: task_theme, size: :xs, classes: 'rounded-bottom-xl') do |feature| %>
      <%= feature.with_header(title: task.name) %>
      <%= feature.with_description { task.summary } if show_summary? %>
      <%= feature.with_tag(t('nav.points', count: task.score),
                           colour: :success, tooltip: t("tasks.points.#{task.public_type}")) %>
      <% if activity_type? %>
        <% learning_stages.each do |learning_stage| %>
          <%= feature.with_tag(learning_stage.abbreviation, colour: :info, tooltip: learning_stage.name) %>
        <% end %>
        <% subject_areas.each do |subject_area| %>
          <%= feature.with_tag(subject_area.name, colour: :warning, tooltip: subject_area_tooltip) %>
        <% end %>
        <% durations.each do |duration| %>
          <%= feature.with_tag(duration.name, colour: :secondary, tooltip: t('activity_types.duration')) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
